import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "lib/iob/blob-id-allocator.h" ]
  public_deps = [
    "//mk/lib/stdcompat",

    # id-allocator.h has #include <lib/fit/result.h>
    "//mk/lib/fit",
  ]
}

source_set("iob") {
  public_deps = [ ":headers" ]
}

group("tests") {
  testonly = true
  deps = [ ":iob-tests($host_toolchain)" ]
}
