import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "pdev/watchdog.h" ]
}

source_set("hw_watchdog") {
  sources = [
    "console.cc",
    "hw_watchdog.cc",
  ]
  public_deps = [ ":headers" ]
  deps = [
    "//mk/lib/arch",
    "//mk/lib/console",
    "//mk/lib/debuglog",
  ]
}
