import("//build/cpp/library_headers.gni")

library_headers("headers") {
  headers = [ "dev/power/motmot/init.h" ]
}

source_set("motmot") {
  sources = [ "power.cc" ]
  public_deps = [ ":headers" ]
  deps = [
    "//mk/dev/pdev/power",
    "//mk/dev/psci",
    "//mk/lib/debuglog",
  ]
}
