import("//build/kernel/zx_library.gni")

zx_library("elf-search") {
  sdk = "source"
  sdk_headers = [ "elf-search.h" ]
  sources = [ "elf-search.cc" ]
  public_deps = [
    "//mk/ulib/fbl",
    "//mk/ulib/zx",
  ]
  deps = [
    "//src/lib/elfldltl",
    "//mk/ulib/fbl",
    "//mk/ulib/trace",
    "//mk/ulib/zx",
  ]
}

group("tests") {
  testonly = true
  deps = [ "test" ]
}
